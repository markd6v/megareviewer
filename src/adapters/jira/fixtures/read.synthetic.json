              "name": "In Progress"
            }
          },
          "description": {
            "type": "doc",
            "version": 1,
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Customers ask support for receipts several times a day. Add a way to download a plain-text receipt for any order from the order page. Receipts should be cached so repeated downloads are cheap; the cache lifetime must be configurable."
                  }
                ]
              }
            ]
          }
        }
      }
