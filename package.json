{
  "name": "megareviewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "megareviewer": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "deps": "depcruise src contracts web/src web/dev",
    "test": "vitest run --coverage",
    "check": "node scripts/check-no-runtime-deps.ts && pnpm typecheck && pnpm lint && pnpm deps && pnpm test",
    "dev:server": "node --watch src/cli/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:fake": "node src/cli/dev/fake-main.ts",
    "build": "node scripts/build.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@biomejs/biome": "2.5.15",
    "@hono/node-server": "2.1.5",
    "@octokit/rest": "22.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "esbuild": "0.28.2",
    "hono": "4.13.13",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.5.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "web-tree-sitter": "0.27.1",
    "zod": "4.6.7"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
